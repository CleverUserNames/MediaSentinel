<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f172a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="64dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MediaSentinel Settings"
            android:textColor="#38bdf8"
            android:textSize="28sp"
            android:textStyle="bold"
            android:paddingBottom="40dp" />

        <!-- MediaSentinel report server URL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MediaSentinel Server URL"
            android:textColor="#e2e8f0"
            android:textSize="18sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/urlInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e293b"
            android:textColor="#e2e8f0"
            android:textSize="18sp"
            android:padding="16dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:hint="http://192.168.1.100:8765"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="The IP:port where the MediaSentinel HTTP server is running (port 8765 by default)."
            android:textColor="#64748b"
            android:textSize="14sp"
            android:layout_marginBottom="36dp" />

        <!-- Jellyseer URL -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Jellyseer URL"
            android:textColor="#e2e8f0"
            android:textSize="18sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/seerInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1e293b"
            android:textColor="#e2e8f0"
            android:textSize="18sp"
            android:padding="16dp"
            android:inputType="textUri"
            android:singleLine="true"
            android:hint="http://192.168.1.100:5055"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Used to open Jellyseer when tapping request buttons in the report."
            android:textColor="#64748b"
            android:textSize="14sp"
            android:layout_marginBottom="48dp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/cancelButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="#94a3b8"
                android:background="@drawable/button_background"
                android:focusable="true"
                android:layout_marginEnd="16dp"
                android:padding="16dp" />

            <Button
                android:id="@+id/resetButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reset Defaults"
                android:textColor="#f59e0b"
                android:background="@drawable/button_background"
                android:focusable="true"
                android:layout_marginEnd="16dp"
                android:padding="16dp" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save"
                android:textColor="#0f172a"
                android:backgroundTint="#38bdf8"
                android:focusable="true"
                android:padding="16dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

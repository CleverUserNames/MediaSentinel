<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f172a">

    <!-- Compact header bar: MS | status | tabs | refresh | settings -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#1e293b"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MS"
            android:textColor="#38bdf8"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingEnd="10dp"/>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#475569"
            android:textSize="11sp"
            android:paddingEnd="8dp"/>

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/tabBar"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"/>

        </HorizontalScrollView>

        <ImageButton
            android:id="@+id/refreshButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="@drawable/button_background"
            android:tint="#38bdf8"
            android:focusable="true"
            android:alpha="0.6"
            android:contentDescription="Refresh"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"/>

        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_preferences"
            android:background="@drawable/button_background"
            android:tint="#94a3b8"
            android:focusable="true"
            android:alpha="0.6"
            android:contentDescription="Settings"
            android:layout_marginEnd="4dp"/>

    </LinearLayout>

    <!-- Thin progress bar -->
    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:indeterminate="true"
        android:indeterminateTint="#38bdf8"
        android:visibility="gone"/>

    <!-- Error view -->
    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Connection Error"
            android:textColor="#ef4444"
            android:textSize="26sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#94a3b8"
            android:textSize="16sp"
            android:gravity="center"
            android:lineSpacingExtra="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#10;Navigate to Refresh button and press OK to retry"
            android:textColor="#38bdf8"
            android:textSize="14sp"
            android:paddingTop="16dp"/>

    </LinearLayout>

    <!-- WebView -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <!-- Nav hint - tiny, bottom -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0d1929"
        android:padding="4dp"
        android:text="UP=header  DOWN/OK=scroll+select  LEFT/RIGHT=navigate  BACK=header  Y=refresh"
        android:textColor="#2d3f55"
        android:textSize="10sp"
        android:gravity="center"/>

</LinearLayout>
